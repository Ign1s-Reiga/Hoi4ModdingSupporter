<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="Hoi4ModdingSupporter.Controls.RecentProjectCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Hoi4ModdingSupporter.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
>
  <Border
    Width="280"
    Height="200"
    Margin="0,0,12,0"
    Padding="12"
    Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="8,8,8,8"
  >
    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid
        Background="{StaticResource LayerFillColorDefaultBrush}"
        CornerRadius="6,6,6,6"
      >
        <FontIcon
          Glyph="&#xE8B7;"
          FontSize="28"
          Foreground="{StaticResource TextFillColorSecondaryBrush}"
        />
      </Grid>

      <TextBlock
        x:Name="displayNameTextBlock"
        Grid.Row="1"
        Style="{StaticResource BodyStrongTextBlockStyle}"
        TextTrimming="CharacterEllipsis"
      />
      <TextBlock
        x:Name="folderPathTextBlock"
        Grid.Row="2"
        Foreground="{StaticResource TextFillColorSecondaryBrush}"
        MaxLines="2"
        TextTrimming="CharacterEllipsis"
        TextWrapping="Wrap"
      />
      <TextBlock
        x:Name="lastAccessedTextBlock"
        Grid.Row="3"
        Foreground="{StaticResource TextFillColorTertiaryBrush}"
        TextTrimming="CharacterEllipsis"
      />
    </Grid>
  </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="Hoi4ModdingSupporter.Views.ProjectWorkspaceView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:Hoi4ModdingSupporter.Controls"
  xmlns:models="using:Hoi4ModdingSupporter.Models"
  mc:Ignorable="d"
>
  <Grid Margin="36" RowSpacing="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="4">
      <controls:HeaderText
        TitleText="{x:Bind ViewModel.Project.DisplayName, Mode=OneWay}"
        TextStyle="{StaticResource TitleTextBlockStyle}"
      />
      <TextBlock
        Text="{x:Bind ViewModel.Project.FolderPath, Mode=OneWay}"
        Foreground="{StaticResource TextFillColorSecondaryBrush}"
        TextTrimming="CharacterEllipsis"
      />
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock
            VerticalAlignment="Center"
            Text="Visual Mod Editor"
            Style="{StaticResource BodyStrongTextBlockStyle}"
          />
          <Button
            Content="Refresh"
            Command="{x:Bind ViewModel.RefreshFilesCommand, Mode=OneWay}"
          />
        </StackPanel>

        <Grid
          Grid.Row="1"
          RowSpacing="8"
          Visibility="{x:Bind ViewModel.VisualEditorVisibility, Mode=OneWay}"
        >
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ComboBox
            DisplayMemberPath="DisplayName"
            IsEnabled="{x:Bind ViewModel.CanChangeWorkspaceSelection, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.FileGroups, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedFileGroup, Mode=TwoWay}"
          />

          <TextBox
            Grid.Row="1"
            IsEnabled="{x:Bind ViewModel.CanChangeWorkspaceSelection, Mode=OneWay}"
            PlaceholderText="Filter scripts"
            Text="{x:Bind ViewModel.FileSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          />

          <ListView
            Grid.Row="2"
            IsEnabled="{x:Bind ViewModel.CanChangeWorkspaceSelection, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.FilteredEditableFiles, Mode=OneWay}"
            SelectionChanged="OnFileSelectionChanged"
          >
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:ProjectWorkspaceFile">
                <StackPanel Padding="0,4">
                  <TextBlock
                    Text="{x:Bind RelativePath}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <TextBlock
                    Text="{x:Bind Extension}"
                    Foreground="{StaticResource TextFillColorTertiaryBrush}"
                  />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>

        <Grid
          Grid.Row="1"
          RowSpacing="8"
          Visibility="{x:Bind ViewModel.NationalFocusVisibility, Mode=OneWay}"
        >
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock
            Text="National Focus Files"
            Style="{StaticResource BodyStrongTextBlockStyle}"
          />

          <ListView
            Grid.Row="1"
            IsEnabled="{x:Bind ViewModel.CanChangeWorkspaceSelection, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.NationalFocusFiles, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedNationalFocusFile, Mode=TwoWay}"
            SelectionChanged="OnNationalFocusFileSelectionChanged"
          >
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:ProjectWorkspaceFile">
                <StackPanel Padding="0,4">
                  <TextBlock
                    Text="{x:Bind RelativePath}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <TextBlock
                    Text=".txt"
                    Foreground="{StaticResource TextFillColorTertiaryBrush}"
                  />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>

        <Grid
          Grid.Row="1"
          RowSpacing="8"
          Visibility="{x:Bind ViewModel.ModAssetsVisibility, Mode=OneWay}"
        >
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ComboBox
            DisplayMemberPath="DisplayName"
            ItemsSource="{x:Bind ViewModel.AssetGroups, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedAssetGroup, Mode=TwoWay}"
          />

          <ListView
            Grid.Row="1"
            IsEnabled="{x:Bind ViewModel.CanChangeWorkspaceSelection, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.SelectedAssetEntries, Mode=OneWay}"
            SelectionChanged="OnFileSelectionChanged"
          >
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:ProjectWorkspaceFile">
                <StackPanel Padding="0,4">
                  <TextBlock
                    Text="{x:Bind RelativePath}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <TextBlock
                    Text="{x:Bind Extension}"
                    Foreground="{StaticResource TextFillColorTertiaryBrush}"
                  />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>

        <Grid
          Grid.Row="1"
          RowSpacing="8"
          Visibility="{x:Bind ViewModel.GameAssetsVisibility, Mode=OneWay}"
        >
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ComboBox
            DisplayMemberPath="DisplayName"
            ItemsSource="{x:Bind ViewModel.GameAssetGroups, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedGameAssetGroup, Mode=TwoWay}"
          />

          <ListView
            Grid.Row="1"
            IsEnabled="{x:Bind ViewModel.CanChangeWorkspaceSelection, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.SelectedGameAssetEntries, Mode=OneWay}"
            SelectionChanged="OnFileSelectionChanged"
          >
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:ProjectWorkspaceFile">
                <StackPanel Padding="0,4">
                  <TextBlock
                    Text="{x:Bind RelativePath}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <TextBlock
                    Text="{x:Bind Extension}"
                    Foreground="{StaticResource TextFillColorTertiaryBrush}"
                  />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Grid>

      <Grid
        Grid.Column="1"
        Grid.ColumnSpan="2"
        RowSpacing="12"
        Visibility="{x:Bind ViewModel.VisualEditorVisibility, Mode=OneWay}"
      >
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock
            VerticalAlignment="Center"
            Text="{x:Bind ViewModel.SelectedFileTitle, Mode=OneWay}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
          />
          <TextBlock
            VerticalAlignment="Center"
            Text="{x:Bind ViewModel.SelectedFileStatusText, Mode=OneWay}"
            Foreground="{StaticResource TextFillColorSecondaryBrush}"
          />
          <Button
            Content="Save"
            Command="{x:Bind ViewModel.SaveSelectedFileCommand, Mode=OneWay}"
          />
        </StackPanel>

        <TextBox
          Grid.Row="1"
          AcceptsReturn="True"
          FontFamily="Consolas"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          IsReadOnly="{x:Bind ViewModel.IsEditorReadOnly, Mode=OneWay}"
          Text="{x:Bind ViewModel.SelectedFileContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          TextWrapping="NoWrap"
          VerticalAlignment="Stretch"
          VerticalContentAlignment="Stretch"
        />
      </Grid>

      <Grid
        Grid.Column="1"
        RowSpacing="12"
        Visibility="{x:Bind ViewModel.NationalFocusVisibility, Mode=OneWay}"
      >
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock
            VerticalAlignment="Center"
            Text="National Focus Canvas"
            Style="{StaticResource BodyStrongTextBlockStyle}"
          />
          <TextBlock
            VerticalAlignment="Center"
            Text="{x:Bind ViewModel.SelectedNationalFocusFile.RelativePath, Mode=OneWay, FallbackValue='Select a focus file'}"
            Foreground="{StaticResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
          />
        </StackPanel>

        <ScrollViewer
          Grid.Row="1"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
        >
          <Canvas
            x:Name="nationalFocusCanvas"
            Width="1800"
            Height="1200"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          />
        </ScrollViewer>
      </Grid>

      <Grid
        Grid.Column="2"
        RowSpacing="10"
        Visibility="{x:Bind ViewModel.NationalFocusVisibility, Mode=OneWay}"
      >
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
          Text="Focus Details"
          Style="{StaticResource BodyStrongTextBlockStyle}"
        />

        <ComboBox
          Grid.Row="1"
          DisplayMemberPath="DisplayName"
          HorizontalAlignment="Stretch"
          IsEnabled="{x:Bind ViewModel.CanChangeWorkspaceSelection, Mode=OneWay}"
          ItemsSource="{x:Bind ViewModel.VisibleNationalFocuses, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedNationalFocus, Mode=TwoWay}"
          SelectionChanged="OnNationalFocusSelectionChanged"
        />

        <TextBox
          Grid.Row="2"
          Header="ID"
          Text="{x:Bind ViewModel.NationalFocusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        />

        <TextBox
          Grid.Row="3"
          Header="Icon"
          Text="{x:Bind ViewModel.NationalFocusIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        />

        <Grid Grid.Row="4" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox
            Header="X"
            Text="{x:Bind ViewModel.NationalFocusX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          />
          <TextBox
            Grid.Column="1"
            Header="Y"
            Text="{x:Bind ViewModel.NationalFocusY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          />
          <TextBox
            Grid.Column="2"
            Header="Cost"
            Text="{x:Bind ViewModel.NationalFocusCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          />
        </Grid>

        <TextBox
          Grid.Row="5"
          AcceptsReturn="True"
          FontFamily="Consolas"
          Header="Effects"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          Text="{x:Bind ViewModel.NationalFocusEffects, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          TextWrapping="NoWrap"
          VerticalAlignment="Stretch"
          VerticalContentAlignment="Stretch"
        />

        <Button
          Grid.Row="6"
          HorizontalAlignment="Right"
          Content="Save Focus"
          Command="{x:Bind ViewModel.SaveNationalFocusCommand, Mode=OneWay}"
        />
      </Grid>
    </Grid>

    <TextBlock
      Grid.Row="2"
      Text="{x:Bind ViewModel.WorkspaceStatusText, Mode=OneWay}"
      Foreground="{StaticResource TextFillColorSecondaryBrush}"
      TextTrimming="CharacterEllipsis"
    />
  </Grid>
</Page>
